{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git config *)",
      "Bash(git log *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(uv *)",
      "Bash(wc *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.envrc)"
    ],
    "ask": []
  },
  "extraKnownMarketplaces": {
    "my-claude-marketplace": {
      "source": {
        "source": "github",
        "repo": "michellepace/my-claude-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "git-utils@my-claude-marketplace": true
  }
}
